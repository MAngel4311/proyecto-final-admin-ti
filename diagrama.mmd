
flowchart LR

    subgraph RED["Red local de la CRQ"]
        CLIENTES["Equipos clientes"]
        LINUX["Clientes Linux"]
        WINDOWS["Clientes Windows / Mac"]
        IMPRESORAS["Impresoras de red"]
    end

    subgraph DOKPLOY["Plataforma de aplicaciones"]
        TRAEFIK["Dokploy / Traefik"]
        WEB["Servidor web Nginx"]
        API["Backend API"]
        PANEL["Panel administrativo"]
        DB[("Base de datos MySQL / PostgreSQL")]

        TRAEFIK --> WEB
        TRAEFIK --> API
        TRAEFIK --> PANEL
        API --> DB
    end

    subgraph SERVIDOR["Servidor Linux - Servicios de infraestructura"]
        NTP["NTP - Sincronización horaria"]
        NFS["NFS - Archivos compartidos"]
        NIS["NIS - Autenticación centralizada"]
        CUPS["CUPS - Servicio de impresión"]
        SAMBA["Samba - Compartición de archivos"]
    end

    CLIENTES --> TRAEFIK

    NTP --> CLIENTES
    NFS --> LINUX
    NIS --> LINUX
    CUPS --> IMPRESORAS
    SAMBA --> WINDOWS

    CLIENTES -. "Solicitudes de impresión" .-> CUPS

    classDef red fill:#e8f1ff,stroke:#2563eb,color:#0f172a
    classDef plataforma fill:#e8f8ee,stroke:#16a34a,color:#0f172a
    classDef servidor fill:#fff4e5,stroke:#ea580c,color:#0f172a

    class CLIENTES,LINUX,WINDOWS,IMPRESORAS red
    class TRAEFIK,WEB,API,PANEL,DB plataforma
    class NTP,NFS,NIS,CUPS,SAMBA servidor

    style RED fill:#f5f9ff,stroke:#2563eb
    style DOKPLOY fill:#f4fbf6,stroke:#16a34a
    style SERVIDOR fill:#fffaf2,stroke:#ea580c
